[alias]
	co = checkout
	b = branch
	cm = commit -m
	co- = checkout -
	com = "!f() { git checkout $(git symbolic-ref refs/remotes/origin/HEAD | sed \"s@^refs/remotes/origin/@@\"); }; f"
	l = pull
	p = push
	a = add
	cl = clone
	rv = remote -v
	aa = add .
	acm = !git add . && git commit -m
	c = !git reset && git checkout -- .
	cob = checkout -b
[user]
	name = David Hoeppner
[credential]
	helper = osxkeychain
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[core]
	excludesfile = ~/.config/git/ignore
	editor = vim
	# Built-in filesystem monitor. Massive `git status` speedup on large
	# repos (e.g. space-flavor goes from ~700ms to ~30ms). Safe on small
	# repos. Requires git >= 2.37.
	fsmonitor = false
	untrackedCache = true
	editr = vim
	# delta: syntax-highlighted diffs. Guarded so `git diff` still works on a
	# machine without delta (falls back to git's default `less`).
	pager = "if command -v delta >/dev/null 2>&1; then delta; else less; fi"

[interactive]
	# Colors `git add -p` hunks with delta; plain passthrough without it.
	diffFilter = "if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi"

[delta]
	navigate = true      # n / N jump between files in the pager
	line-numbers = true

# Work-only overrides (email, company-internal credential helpers, etc.)
# live in an uncommitted file next to this one. The filename contains
# "IGNORE" to match the `*IGNORE*` rule in ~/.config/.gitignore.
#
# If the file doesn't exist, git silently skips it (path = vs path is
# required = ...). Each machine scaffolds its own copy via install.sh.
[include]
	path = ~/.config/git/IGNORE_work_config
[sequence]
	editor = vim
[branch]
	autoSetupMerge = simple
