# ── Font ──────────────────────────────────────────────────
font-family = FiraCode Nerd Font Mono
font-size = 13

# ── Theme ─────────────────────────────────────────────────
# Run `ghostty +list-themes | grep -i tokyo` to verify the exact name
theme = TokyoNight Storm

# ── Window ────────────────────────────────────────────────
background-opacity = 0.9
background-blur = 30
# Unit is bytes, not lines: 100000000 = 100 MB (default is 10 MB)
scrollback-limit = 100000000

# ── Shell integration ─────────────────────────────────────
shell-integration = detect
# ssh-terminfo: on first SSH to a host, Ghostty installs its terminfo into
#   the remote ~/.terminfo (this includes work hosts reached via cnssh).
# ssh-env: falls back to TERM=xterm-256color if that install fails, and
#   forwards COLORTERM / TERM_PROGRAM.
# Unlisted features (cursor, title, sudo, path) keep their defaults.
shell-integration-features = ssh-terminfo,ssh-env

# ── macOS option key ──────────────────────────────────────
# Left Option = Alt (Alt+. , Alt+b/f in zsh). Right Option keeps macOS
# compose behavior, so it still types ü, €, and similar characters.
# Word-nav binds below stay as an explicit fallback.
macos-option-as-alt = left

# ── URL handling ──────────────────────────────────────────
link-url = true

# ── Keybindings ───────────────────────────────────────────

# Word navigation (opt+arrow → backward/forward word)
keybind = opt+left=esc:b
keybind = opt+right=esc:f

# Pane splits: use Ghostty defaults cmd+d (right) and cmd+shift+d (down).
# Ctrl+V / Ctrl+H stay free for vim, zsh, and zellij.

# Leader key sequences (Cmd+Shift+F > key)
keybind = super+shift+f>w=close_surface
keybind = super+shift+f>j=goto_split:down
keybind = super+shift+f>k=goto_split:up
keybind = super+shift+f>l=goto_split:left
keybind = super+shift+f>semicolon=goto_split:right
keybind = super+shift+f>m=toggle_split_zoom

# Resize splits (3-key: Leader+r+direction; no persistent mode in Ghostty)
keybind = super+shift+f>r>j=resize_split:down,3
keybind = super+shift+f>r>k=resize_split:up,3
keybind = super+shift+f>r>l=resize_split:left,3
keybind = super+shift+f>r>semicolon=resize_split:right,3

# Open config file in $EDITOR (set EDITOR=code in .zshrc for VS Code)
keybind = super+comma=open_config
