# Shell-level git shortcut. The git-level aliases (co, b, cm, com, l, p, a,
# cl, rv, aa, acm, c, cob) are defined in ~/.config/git/config and travel
# with the .config repo — no need to write them to ~/.gitconfig on every
# shell startup (which previously caused concurrent `git config --global`
# invocations to race on ~/.gitconfig.lock when Cursor spawned many shells
# in parallel).
alias g='git'
